SERVER_PORT=8080
FRONTEND_ORIGINS=http://localhost:4200,http://localhost:3000

DB_URL=jdbc:postgresql://localhost:5432/erp_insurance
DB_USERNAME=erp_app
DB_PASSWORD=replace-with-a-long-random-password

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
# Generate at least 32 random bytes; keep secrets in a vault in production.
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_TTL_MINUTES=15

# Optional one-time administrator bootstrap; omit after first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=